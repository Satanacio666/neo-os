{
  "comment": "Golden JIT tests. Each case runs 'cmds' over UART; the value of the LAST command is compared to 'expect' (hex). 'known' cases are pre-existing defects.",
  "cases": [
    { "name": "arith_add_mul",     "cmds": ["2 + 3 * 4;"], "expect": "0xE" },
    { "name": "arith_paren",       "cmds": ["(2 + 3) * 4;"], "expect": "0x14" },
    { "name": "arith_div",         "cmds": ["17 / 5;"], "expect": "0x3" },
    { "name": "arith_mod",         "cmds": ["17 % 5;"], "expect": "0x2" },
    { "name": "arith_neg1",        "cmds": ["0 - 1;"], "expect": "0xFFFFFFFFFFFFFFFF" },
    { "name": "arith_neg100",      "cmds": ["100 - 200;"], "expect": "0xFFFFFFFFFFFFFF9C" },
    { "name": "arith_mul",         "cmds": ["6 * 7;"], "expect": "0x2A" },
    { "name": "bit_shl",           "cmds": ["1 << 40;"], "expect": "0x10000000000" },
    { "name": "bit_and",           "cmds": ["255 & 15;"], "expect": "0xF" },
    { "name": "bit_or",            "cmds": ["256 | 15;"], "expect": "0x10F" },
    { "name": "bit_not",           "cmds": ["~0;"], "expect": "0xFFFFFFFFFFFFFFFF" },
    { "name": "cmp_signed_lt",     "cmds": ["-5 < 3;"], "expect": "0x1" },
    { "name": "cmp_signed_gt",     "cmds": ["-5 > 3;"], "expect": "0x0" },
    { "name": "cmp_neg_rhs",       "cmds": ["5 > -3;"], "expect": "0x1" },
    { "name": "cmp_neg_neg",       "cmds": ["-5 < -3;"], "expect": "0x1" },
    { "name": "logic_and",         "cmds": ["1 && 0;"], "expect": "0x0" },
    { "name": "logic_or",          "cmds": ["1 || 0;"], "expect": "0x1" },
    { "name": "logic_not0",        "cmds": ["!0;"], "expect": "0x1" },
    { "name": "logic_not5",        "cmds": ["!5;"], "expect": "0x0" },
    { "name": "ternary_true",      "cmds": ["(3 > 2) ? 111 : 222;"], "expect": "0x6F" },
    { "name": "ternary_false",     "cmds": ["(3 < 2) ? 111 : 222;"], "expect": "0xDE" },
    { "name": "char_A",            "cmds": ["'A';"], "expect": "0x41" },
    { "name": "char_z",            "cmds": ["'z';"], "expect": "0x7A" },
    { "name": "f64_add",           "cmds": ["3.5 + 1.5;"], "expect": "0x4014000000000000" },
    { "name": "f64_div",           "cmds": ["10.0 / 4.0;"], "expect": "0x4004000000000000" },
    { "name": "f64_mul",           "cmds": ["2.0 * 3.0;"], "expect": "0x4018000000000000" },
    { "name": "f64_sub",           "cmds": ["1.0 - 0.5;"], "expect": "0x3FE0000000000000" },
    { "name": "f64_neg",           "cmds": ["2.0 - 3.0;"], "expect": "0xBFF0000000000000" },
    { "name": "f64_quarter",       "cmds": ["1.0 / 4.0;"], "expect": "0x3FD0000000000000" },
    { "name": "f64_cmp_lt",        "cmds": ["1.0 < 2.0;"], "expect": "0x1" },
    { "name": "f64_cmp_gt_false",  "cmds": ["2.0 < 1.0;"], "expect": "0x0" },
    { "name": "f64_if_branch",     "cmds": ["I64 r = 0; if (2.0 > 1.0) r = 1; r;"], "expect": "0x1" },
    { "name": "f64_param_cmp",     "cmds": ["I64 ff(F64 x) { if (x > 1.0) return 1; return 0; }", "ff(2.5);"], "expect": "0x1" },
    { "name": "f64_loop_accum",    "cmds": ["F64 s = 0.0; for (I64 i = 0; i < 4; i = i + 1) { s = s + 0.25; } s;"], "expect": "0x3FF0000000000000" },
    { "name": "fn_fib10",          "cmds": ["I64 fib(I64 n) { if (n < 2) return n; return fib(n-1) + fib(n-2); }", "fib(10);"], "expect": "0x37" },
    { "name": "fn_recursion_local", "cmds": ["I64 f(I64 n) { I64 t = n; if (n < 2) return t; return f(n-1) + t; }", "f(5);"], "expect": "0xF" },
    { "name": "recursion_local_array", "cmds": ["I64 rf(I64 n) { I64 a[2]; a[0] = n; if (n < 2) return a[0]; return rf(n-1) + a[0]; }", "rf(5);"], "expect": "0xF" },
    { "name": "loop_for_sum",      "cmds": ["I64 s = 0; for (I64 i = 0; i < 5; i = i + 1) { s = s + i; } s;"], "expect": "0xA" },
    { "name": "loop_do_while",     "cmds": ["I64 n = 0; do { n = n + 1; } while (n < 5); n;"], "expect": "0x5" },
    { "name": "switch_fallthrough", "cmds": ["I64 v = 1; switch (v) { case 1: v = v + 10; case 2: v = v + 20; break; default: v = 888; } v;"], "expect": "0x1F" },
    { "name": "struct_recursion",  "cmds": ["struct P { I64 x; I64 y; }", "I64 g(I64 n) { P p; p.x = n; p.y = n * 2; if (n < 2) return p.x + p.y; return g(n-1) + p.x + p.y; }", "g(3);"], "expect": "0x12" },
    { "name": "array_in_function", "cmds": ["I64 h() { I64 a[3]; a[0] = 5; a[1] = 7; return a[0] + a[1]; }", "h();"], "expect": "0xC" },
    { "name": "ptr_write_deref",   "cmds": ["I64 x = 41; I64 *p = &x; *p = 42; x;"], "expect": "0x2A" },
    { "name": "ptr_read_deref",    "cmds": ["I64 v = 7; I64 *q = &v; I64 w = *q; w;"], "expect": "0x7" },
    { "name": "ptr_deref_expr",    "cmds": ["I64 v = 7; I64 *q = &v; (*q) + 1;"], "expect": "0x8" },
    { "name": "member_assign",     "cmds": ["struct Q { I64 x; I64 y; }", "Q qq; qq.x = 5; qq.x = qq.x + 1; qq.x;"], "expect": "0x6" },
    { "name": "mutual_recursion",  "cmds": ["I64 isEven(I64 n) { if (n == 0) return 1; return isOdd(n-1); }", "I64 isOdd(I64 n) { if (n == 0) return 0; return isEven(n-1); }", "isEven(10);"], "expect": "0x1" },
    { "name": "forward_global_var", "cmds": ["I64 getx() { return g_fwd; }", "I64 g_fwd = 42;", "getx();"], "expect": "0x2A" },
    { "name": "forward_struct",    "cmds": ["I64 getfx(F *p) { return p->x; } struct F { I64 x; }; F f; f.x = 9; getfx(&f);"], "expect": "0x9" },
    { "name": "fnptr_addr_of_fn",  "cmds": ["I64 inc(I64 x) { return x + 1; }", "I64 fp = &inc;", "fp(41);"], "expect": "0x2A" },
    { "name": "known_bare_deref_stmt", "known": true, "cmds": ["I64 v = 7; I64 *q = &v; *q;"], "expect": "0x7" }
  ]
}
