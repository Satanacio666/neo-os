{
  "comment": "Golden JIT tests. Each case runs 'cmds' over UART; the value of the LAST command is compared to 'expect' (hex). 'known' cases are pre-existing defects.",
  "cases": [
    {
      "name": "arith_add_mul",
      "cmds": [
        "2 + 3 * 4;"
      ],
      "expect": "0xE"
    },
    {
      "name": "arith_paren",
      "cmds": [
        "(2 + 3) * 4;"
      ],
      "expect": "0x14"
    },
    {
      "name": "arith_div",
      "cmds": [
        "17 / 5;"
      ],
      "expect": "0x3"
    },
    {
      "name": "arith_mod",
      "cmds": [
        "17 % 5;"
      ],
      "expect": "0x2"
    },
    {
      "name": "arith_neg1",
      "cmds": [
        "0 - 1;"
      ],
      "expect": "0xFFFFFFFFFFFFFFFF"
    },
    {
      "name": "arith_neg100",
      "cmds": [
        "100 - 200;"
      ],
      "expect": "0xFFFFFFFFFFFFFF9C"
    },
    {
      "name": "arith_mul",
      "cmds": [
        "6 * 7;"
      ],
      "expect": "0x2A"
    },
    {
      "name": "bit_shl",
      "cmds": [
        "1 << 40;"
      ],
      "expect": "0x10000000000"
    },
    {
      "name": "bit_and",
      "cmds": [
        "255 & 15;"
      ],
      "expect": "0xF"
    },
    {
      "name": "bit_or",
      "cmds": [
        "256 | 15;"
      ],
      "expect": "0x10F"
    },
    {
      "name": "bit_not",
      "cmds": [
        "~0;"
      ],
      "expect": "0xFFFFFFFFFFFFFFFF"
    },
    {
      "name": "cmp_signed_lt",
      "cmds": [
        "-5 < 3;"
      ],
      "expect": "0x1"
    },
    {
      "name": "cmp_signed_gt",
      "cmds": [
        "-5 > 3;"
      ],
      "expect": "0x0"
    },
    {
      "name": "cmp_neg_rhs",
      "cmds": [
        "5 > -3;"
      ],
      "expect": "0x1"
    },
    {
      "name": "cmp_neg_neg",
      "cmds": [
        "-5 < -3;"
      ],
      "expect": "0x1"
    },
    {
      "name": "logic_and",
      "cmds": [
        "1 && 0;"
      ],
      "expect": "0x0"
    },
    {
      "name": "logic_or",
      "cmds": [
        "1 || 0;"
      ],
      "expect": "0x1"
    },
    {
      "name": "logic_not0",
      "cmds": [
        "!0;"
      ],
      "expect": "0x1"
    },
    {
      "name": "logic_not5",
      "cmds": [
        "!5;"
      ],
      "expect": "0x0"
    },
    {
      "name": "ternary_true",
      "cmds": [
        "(3 > 2) ? 111 : 222;"
      ],
      "expect": "0x6F"
    },
    {
      "name": "ternary_false",
      "cmds": [
        "(3 < 2) ? 111 : 222;"
      ],
      "expect": "0xDE"
    },
    {
      "name": "char_A",
      "cmds": [
        "'A';"
      ],
      "expect": "0x41"
    },
    {
      "name": "char_z",
      "cmds": [
        "'z';"
      ],
      "expect": "0x7A"
    },
    {
      "name": "f64_add",
      "cmds": [
        "3.5 + 1.5;"
      ],
      "expect": "0x4014000000000000"
    },
    {
      "name": "f64_div",
      "cmds": [
        "10.0 / 4.0;"
      ],
      "expect": "0x4004000000000000"
    },
    {
      "name": "f64_mul",
      "cmds": [
        "2.0 * 3.0;"
      ],
      "expect": "0x4018000000000000"
    },
    {
      "name": "f64_sub",
      "cmds": [
        "1.0 - 0.5;"
      ],
      "expect": "0x3FE0000000000000"
    },
    {
      "name": "f64_neg",
      "cmds": [
        "2.0 - 3.0;"
      ],
      "expect": "0xBFF0000000000000"
    },
    {
      "name": "f64_quarter",
      "cmds": [
        "1.0 / 4.0;"
      ],
      "expect": "0x3FD0000000000000"
    },
    {
      "name": "f64_cmp_lt",
      "cmds": [
        "1.0 < 2.0;"
      ],
      "expect": "0x1"
    },
    {
      "name": "f64_cmp_gt_false",
      "cmds": [
        "2.0 < 1.0;"
      ],
      "expect": "0x0"
    },
    {
      "name": "f64_if_branch",
      "cmds": [
        "I64 r = 0; if (2.0 > 1.0) r = 1; r;"
      ],
      "expect": "0x1"
    },
    {
      "name": "f64_param_cmp",
      "cmds": [
        "I64 ff(F64 x) { if (x > 1.0) return 1; return 0; }",
        "ff(2.5);"
      ],
      "expect": "0x1"
    },
    {
      "name": "f64_loop_accum",
      "cmds": [
        "F64 s = 0.0; for (I64 i = 0; i < 4; i = i + 1) { s = s + 0.25; } s;"
      ],
      "expect": "0x3FF0000000000000"
    },
    {
      "name": "fn_fib10",
      "cmds": [
        "I64 fib(I64 n) { if (n < 2) return n; return fib(n-1) + fib(n-2); }",
        "fib(10);"
      ],
      "expect": "0x37"
    },
    {
      "name": "fn_recursion_local",
      "cmds": [
        "I64 f(I64 n) { I64 t = n; if (n < 2) return t; return f(n-1) + t; }",
        "f(5);"
      ],
      "expect": "0xF"
    },
    {
      "name": "recursion_local_array",
      "cmds": [
        "I64 rf(I64 n) { I64 a[2]; a[0] = n; if (n < 2) return a[0]; return rf(n-1) + a[0]; }",
        "rf(5);"
      ],
      "expect": "0xF"
    },
    {
      "name": "loop_for_sum",
      "cmds": [
        "I64 s = 0; for (I64 i = 0; i < 5; i = i + 1) { s = s + i; } s;"
      ],
      "expect": "0xA"
    },
    {
      "name": "loop_do_while",
      "cmds": [
        "I64 n = 0; do { n = n + 1; } while (n < 5); n;"
      ],
      "expect": "0x5"
    },
    {
      "name": "switch_fallthrough",
      "cmds": [
        "I64 v = 1; switch (v) { case 1: v = v + 10; case 2: v = v + 20; break; default: v = 888; } v;"
      ],
      "expect": "0x1F"
    },
    {
      "name": "struct_recursion",
      "cmds": [
        "struct P { I64 x; I64 y; }",
        "I64 g(I64 n) { P p; p.x = n; p.y = n * 2; if (n < 2) return p.x + p.y; return g(n-1) + p.x + p.y; }",
        "g(3);"
      ],
      "expect": "0x12"
    },
    {
      "name": "array_in_function",
      "cmds": [
        "I64 h() { I64 a[3]; a[0] = 5; a[1] = 7; return a[0] + a[1]; }",
        "h();"
      ],
      "expect": "0xC"
    },
    {
      "name": "ptr_write_deref",
      "cmds": [
        "I64 x = 41; I64 *p = &x; *p = 42; x;"
      ],
      "expect": "0x2A"
    },
    {
      "name": "ptr_read_deref",
      "cmds": [
        "I64 v = 7; I64 *q = &v; I64 w = *q; w;"
      ],
      "expect": "0x7"
    },
    {
      "name": "ptr_deref_expr",
      "cmds": [
        "I64 v = 7; I64 *q = &v; (*q) + 1;"
      ],
      "expect": "0x8"
    },
    {
      "name": "member_assign",
      "cmds": [
        "struct Q { I64 x; I64 y; }",
        "Q qq; qq.x = 5; qq.x = qq.x + 1; qq.x;"
      ],
      "expect": "0x6"
    },
    {
      "name": "mutual_recursion",
      "cmds": [
        "I64 isEven(I64 n) { if (n == 0) return 1; return isOdd(n-1); }",
        "I64 isOdd(I64 n) { if (n == 0) return 0; return isEven(n-1); }",
        "isEven(10);"
      ],
      "expect": "0x1"
    },
    {
      "name": "forward_global_var",
      "cmds": [
        "I64 getx() { return g_fwd; }",
        "I64 g_fwd = 42;",
        "getx();"
      ],
      "expect": "0x2A"
    },
    {
      "name": "forward_struct",
      "cmds": [
        "I64 getfx(F *p) { return p->x; } struct F { I64 x; }; F f; f.x = 9; getfx(&f);"
      ],
      "expect": "0x9"
    },
    {
      "name": "fnptr_addr_of_fn",
      "cmds": [
        "I64 inc(I64 x) { return x + 1; }",
        "I64 fp = &inc;",
        "fp(41);"
      ],
      "expect": "0x2A"
    },
    {
      "name": "bare_deref_stmt",
      "cmds": [
        "I64 v = 7; I64 *q = &v; *q;"
      ],
      "expect": "0x7"
    },
    {
      "name": "inline_asm_mov",
      "cmds": [
        "asm { 0xD2800540 };"
      ],
      "expect": "0x2A"
    },
    {
      "name": "f64_struct_member",
      "cmds": [
        "struct FVec { F64 x; F64 y; }",
        "FVec fv; fv.x = 1.5; fv.y = 2.5; fv.x + fv.y;"
      ],
      "expect": "0x4010000000000000"
    },
    {
      "name": "f64_struct_ptr_arrow",
      "cmds": [
        "struct FBox { F64 w; F64 h; }",
        "FBox fb; FBox *fpb = &fb; fpb->w = 2.5; fpb->h = 1.5; fpb->w * fpb->h;"
      ],
      "expect": "0x400E000000000000"
    },
    {
      "name": "f64_array_member",
      "cmds": [
        "struct M16 { F64 m[16]; }",
        "M16 mm; mm.m[0] = 1.0; mm.m[15] = 2.0; mm.m[0] + mm.m[15];"
      ],
      "expect": "0x4008000000000000"
    },
    {
      "name": "f64_array_member_index",
      "cmds": [
        "struct M16 { F64 m[16]; }",
        "M16 mm2; mm2.m[5] = 2.0; mm2.m[10] = 5.0; mm2.m[10] - mm2.m[5];"
      ],
      "expect": "0x4008000000000000"
    },
    {
      "name": "f64_int_cast",
      "cmds": [
        "I64 k = 7; (F64)k + 0.5;"
      ],
      "expect": "0x401E000000000000"
    },
    {
      "name": "f64_to_int_cast",
      "cmds": [
        "F64 fx = 3.9; I64 n = (I64)fx; n;"
      ],
      "expect": "0x3"
    },
    {
      "name": "f64_cross_chain",
      "cmds": [
        "struct V3 { F64 x; F64 y; F64 z; }",
        "V3 va; V3 vb; va.x=0.0; va.y=1.0; va.z=0.0; vb.x=0.0; vb.y=0.0; vb.z=1.0; va.y*vb.z - va.z*vb.y;"
      ],
      "expect": "0x3FF0000000000000"
    },
    {
      "name": "f64_struct_param",
      "cmds": [
        "struct DV { F64 x; }",
        "F64 getdv(DV *p) { return p->x; } DV dd; dd.x = 2.5; getdv(&dd);"
      ],
      "expect": "0x4004000000000000"
    },
    {
      "name": "macro_define_add",
      "cmds": [
        "#define MAC21 21",
        "MAC21 + MAC21;"
      ],
      "expect": "0x2A"
    },
    {
      "name": "macro_define_expr",
      "cmds": [
        "#define MACEXPR 6 * 7",
        "MACEXPR;"
      ],
      "expect": "0x2A"
    },
    {
      "name": "addr_of_array_elem",
      "cmds": [
        "I64 aa[3]; aa[0] = 10; aa[1] = 20; aa[2] = 30; I64 *ap = &aa[1]; *ap;"
      ],
      "expect": "0x14"
    },
    {
      "name": "addr_of_array_elem_write",
      "note": "The C JIT REPL returns the *address* (not the value) for a bare top-level array-index rvalue; wrap the read in a function so both engines evaluate it correctly. Compiler.HC handles the bare top-level form too (see scripts/p1-parity.sh).",
      "cmds": [
        "I64 abw() { I64 ab[3]; ab[0] = 5; I64 *bp = &ab[2]; *bp = 9; return ab[2]; } abw();"
      ],
      "expect": "0x9"
    },
    {
      "name": "forward_call",
      "cmds": [
        "I64 fcaller() { return fcallee(5); }",
        "I64 fcallee(I64 x) { return x * 2; }",
        "fcaller();"
      ],
      "expect": "0xA"
    },
    {
      "name": "global_array",
      "note": "Cross-compile globals are the documented one-compile-per-boot limit (J1), so declare and use in a single unit. Bare top-level array-index rvalues also misread in the C JIT REPL, hence the function wrapper.",
      "cmds": [
        "I64 g_parr[4]; I64 gparw() { g_parr[0] = 3; g_parr[3] = 9; return g_parr[0] + g_parr[3]; } gparw();"
      ],
      "expect": "0xC"
    },
    {
      "name": "auto_decl",
      "note": "TempleOS/HolyC 'auto' storage class (behaves as I64).",
      "cmds": [
        "auto av = 7; av + 1;"
      ],
      "expect": "0x8"
    },
    {
      "name": "array_init_global",
      "note": "Top-level array initializer list.",
      "cmds": [
        "I64 ai3[3] = {10, 20, 30}; ai3[0] + ai3[2];"
      ],
      "expect": "0x28"
    },
    {
      "name": "array_init_one_elem",
      "note": "1-element array is still an array (g_has_bracket, not g_count>1).",
      "cmds": [
        "I64 aone[1] = {7}; aone[0];"
      ],
      "expect": "0x7"
    },
    {
      "name": "array_init_local",
      "note": "Function-local array initializer list.",
      "cmds": [
        "I64 laf() { I64 la3[3] = {4, 5, 6}; return la3[0] + la3[2]; } laf();"
      ],
      "expect": "0xA"
    },
    {
      "name": "array_init_f64",
      "note": "F64 array initializer list stores IEEE-754 bits; 1.5 + 2.5 = 4.0.",
      "cmds": [
        "F64 af2[2] = {1.5, 2.5}; af2[0] + af2[1];"
      ],
      "expect": "0x4010000000000000"
    },
    {
      "name": "fnptr_indirect_call",
      "note": "Call through a global function pointer (indirect blr).",
      "cmds": [
        "I64 fci(I64 x) { return x + 1; }",
        "I64 fcp = &fci;",
        "fcp(41);"
      ],
      "expect": "0x2A"
    },
    {
      "name": "forward_struct_ptr",
      "note": "Forward struct used via pointer before its definition (pre-scan).",
      "cmds": [
        "I64 gfsp(F2 *p) { return p->x; } struct F2 { I64 x; }; F2 ff2; ff2.x = 9; gfsp(&ff2);"
      ],
      "expect": "0x9"
    },
    {
      "name": "include_vfs",
      "note": "Compiler.HC #include splices a RedSea file (5 + 2 = 7).",
      "cmds": [
        "save __inc1.HC I64 g_inc = 5;",
        "save __inc2.HC #include \"__inc1.HC\" g_inc + 2;",
        "run __inc2.HC"
      ],
      "expect": "0x7"
    },
    {
      "name": "known_over8_args",
      "known": true,
      "cmds": [
        "I64 nine(I64 a,I64 b,I64 c,I64 d,I64 e,I64 f,I64 g,I64 h,I64 i) { return a + i; } nine(1,2,3,4,5,6,7,8,9);"
      ],
      "expect": "0xFFFFFFFFFFFFFFFF"
    }
  ]
}