# NeoOS web console — environment overrides (all optional; sensible defaults below).
#
# Root of the NeoOS source tree. Defaults to the nearest ancestor of this harness
# that contains `scripts/run-viewer-vm.sh` (i.e. the repo root when the harness is
# at `<repo>/harness`). Set this only if the harness runs from a different checkout.
# NEO_OS_ROOT=/path/to/neo-os

# VNC endpoint exposed by scripts/run-viewer-vm.sh (`-vnc 127.0.0.1:0`).
# NEO_VNC_HOST=127.0.0.1
# NEO_VNC_PORT=5900

# UART input socket + serial log created by scripts/run-viewer-vm.sh (uart-bridge.mjs).
# NEO_UART_IN_SOCK=/tmp/neo-os-uart-in.sock
# NEO_SERIAL_LOG=/tmp/neo-os-serial.log

# VM pid file written by scripts/run-viewer-vm.sh.
# NEO_VM_PIDFILE=/tmp/neo-os-vm.pid
